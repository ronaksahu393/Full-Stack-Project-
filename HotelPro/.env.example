# HotelPro Root Environment Example
# Copy this file to server/.env or configure server/.env directly.
# See server/.env.example for comprehensive details.

PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/hotelpro
JWT_SECRET=your_secure_random_jwt_secret_here_minimum_32_chars
NODE_ENV=development

# Data Store Configuration:
ALLOW_IN_MEMORY_DB=true
# DATA_STORE=mongodb # Options: "mongodb" (default) or "memory"

# Hotel Inventory Provider Mode: "demo" (curated Indian catalog) or "live" (external GDS/OTA)
HOTEL_INVENTORY_PROVIDER=demo

# Live Hotel Inventory Provider Credentials (required only when HOTEL_INVENTORY_PROVIDER=live)
LIVE_HOTEL_API_KEY=
LIVE_HOTEL_API_SECRET=
LIVE_HOTEL_API_ENDPOINT=https://api.amadeus.com/v1
LIVE_HOTEL_TIMEOUT_MS=6000

# Optional Payment Gateways & Webhook Verification
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_LIVE_VERIFIED=true # Set true when live Stripe server-to-server settlement is provisioned
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional CORS Origin overrides (comma-separated if multiple; defaults to standard localhost origins)
# CORS_ORIGIN=http://localhost:5173,http://localhost:5000
